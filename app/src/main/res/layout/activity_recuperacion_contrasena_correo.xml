<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ImageView
        android:id="@+id/imgPalmas"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_alignParentBottom="true"
        android:src="@drawable/palmas"
        android:scaleType="fitXY"
        android:alpha="0.6" />

    <ImageView
        android:id="@+id/imgArriba2"
        android:layout_width="500dp"
        android:layout_height="20dp"
        android:scaleType="centerCrop"
        android:src="@drawable/arriba2"/>

    <LinearLayout
        android:id="@+id/layoutContenedorPrincipal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/imgSuperior2"
            android:layout_width="120dp"
            android:layout_height="150dp"
            android:src="@drawable/superior2"
            android:layout_marginTop="40dp" />

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="Recuperar Contraseña"
            android:textColor="#000"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/layoutFormulario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#D3D3D3"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:id="@+id/tvLabelLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Iniciar sesión"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="8dp"
                android:background="#fff"
                android:hint="usuario@ejemplo.com"
                android:paddingLeft="16dp"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="200dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:backgroundTint="#FF5E1A"
                android:text="Enviar Codigo"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>