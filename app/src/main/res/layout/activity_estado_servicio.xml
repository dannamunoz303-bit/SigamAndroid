<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&lt;-"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtTituloEstadoServicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="                         Estado del servicio"
            android:textSize="16sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <View
        android:id="@+id/viewLineaNaranja"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#FF6A2E" />

    <ScrollView
        android:id="@+id/scrollEstadoServicio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/layoutContenidoTimeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/layoutTimeline"
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <View
                    android:id="@+id/viewLineTop"
                    android:layout_width="2dp"
                    android:layout_height="20dp"
                    android:background="#E0E0E0" />

                <View
                    android:id="@+id/viewDot1"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/circulo" />

                <View
                    android:id="@+id/viewLine1"
                    android:layout_width="2dp"
                    android:layout_height="50dp"
                    android:background="#E0E0E0" />

                <TextView
                    android:id="@+id/tvTimelineStep2"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/circulooo"
                    android:gravity="center"
                    android:text="2"
                    android:textSize="10sp"
                    android:textColor="#FF6A2E"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/viewLine2"
                    android:layout_width="2dp"
                    android:layout_height="60dp"
                    android:background="#E0E0E0" />

                <View
                    android:id="@+id/viewLineBottom"
                    android:layout_width="2dp"
                    android:layout_height="20dp"
                    android:background="#E0E0E0" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/layoutCardLlegada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#f5f5f5f5"
                    android:padding="12dp">

                    <LinearLayout
                        android:id="@+id/layoutHeaderLlegada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtTituloLlegada"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Llegada al incidente"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/txtHoraLlegada"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10:42 AM"
                            android:textSize="11sp"
                            android:textColor="#888888" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtDescLlegada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Ubicación confirmada."
                        android:textSize="12sp"
                        android:textColor="#666666" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutCardInicioTraslado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:background="#FFDBBB"
                    android:padding="12dp">

                    <LinearLayout
                        android:id="@+id/layoutHeaderInicioTraslado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtTituloInicioTraslado"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Inicio del traslado"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/txtEstadoEnCurso"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="En curso"
                            android:textSize="12sp"
                            android:textColor="#FF6A2E" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtDescInicioTraslado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Preparando paciente para el traslado."
                        android:textSize="12sp"
                        android:textColor="#444444" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutCardLlegadaHospital"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/txtTituloLlegadaHospital"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Llegada al hospital"
                        android:textSize="13sp"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/txtDescLlegadaHospital"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Pendiente de inicio."
                        android:shadowColor="#89898989"
                        android:textSize="12sp"
                        android:textColor="#AAAAAA" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutBotones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/btnConfirmarInicioTraslado"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FF6A2E"
            android:textColor="@color/white"
            android:gravity="center"
            android:text="CONFIRMAR INICIO DE TRASLADO"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>