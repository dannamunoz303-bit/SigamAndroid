<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&lt;-"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtTituloReportarNovedad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="                          Reportar Novedad"
            android:textSize="17sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <View
        android:id="@+id/viewLineaNaranja"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#FF6A2E" />

    <ScrollView
        android:id="@+id/scrollReportarNovedad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/layoutContenido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/txtLabelTipoNovedad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIPO DE NOVEDAD"
                android:textSize="12sp"
                android:textColor="#444444"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutTiposNovedad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnTipoDano"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#f5f5f5f5">

                    <ImageView
                        android:id="@+id/imgTipoDano"
                        android:layout_width="40dp"
                        android:layout_height="30dp"
                        android:src="@drawable/guiaa"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/txtTipoDano"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Daño"
                        android:textSize="13sp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnTipoCongestion"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#f5f5f5f5">

                    <ImageView
                        android:id="@+id/imgTipoCongestion"
                        android:layout_width="40dp"
                        android:layout_height="30dp"
                        android:src="@drawable/semaforo"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/txtTipoCongestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Congestión"
                        android:textSize="13sp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnTipoBloqueo"
                    android:layout_width="0dp"
                    android:layout_height="75dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#f5f5f5f5">

                    <ImageView
                        android:id="@+id/imgTipoBloqueo"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/bloqueo"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/txtTipoBloqueo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Bloqueo"
                        android:textSize="13sp"/>

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/txtLabelDescripcion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="DESCRIPCIÓN"
                android:textSize="12sp"
                android:textColor="#444444"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDescripcion"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/fondofondo"
                android:hint="Describe la situación..."
                android:textSize="14sp"
                android:textColorHint="#AAAAAA"
                android:padding="12dp"
                android:gravity="top"
                android:inputType="textMultiLine" />

            <TextView
                android:id="@+id/txtLabelEvidencia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="EVIDENCIA GRÁFICA"
                android:textSize="12sp"
                android:textColor="#444444"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btnAdjuntarFoto"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#F5F5F5">

                <ImageView
                    android:id="@+id/imgCamara"
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:src="@drawable/camaraa"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/txtAdjuntarFoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:text="Adjuntar Foto"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtHintFoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Adjunta una foto como evidencia de la novedad."
                android:textSize="12sp"
                android:textColor="#545454" />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutBotones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/btnEnviarReporte"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:background="@drawable/btn_redondo"
            android:text="ENVIAR REPORTE"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>