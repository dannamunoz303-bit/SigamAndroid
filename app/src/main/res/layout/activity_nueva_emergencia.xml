<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/layoutContenidoCentral"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/imgTriangulo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="40dp"
            android:src="@drawable/triangulo" />

        <TextView
            android:id="@+id/txtNueva"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="¡NUEVA"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FF6A2E"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtEmergencia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMERGENCIA!"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FF6A2E"
            android:gravity="center" />

        <LinearLayout
            android:id="@+id/layoutCardInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtLabelUbicacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="UBICACIÓN"
                android:textSize="14sp"
                android:gravity="center"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/txtUbicacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Calle 5 #9-23, Edificio A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center" />

            <View
                android:id="@+id/viewDivider"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="#54545454" />

            <TextView
                android:id="@+id/txtLabelTipo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIPO DE INCIDENTE"
                android:textSize="12sp"/>

            <LinearLayout
                android:id="@+id/layoutTipoIncidente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imgCarro"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="0dp"
                    android:src="@drawable/carro" />

                <TextView
                    android:id="@+id/txtTipoIncidente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Accidente de tránsito con heridos"
                    android:textSize="14sp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/txtLabelDistancia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="DISTANCIA ESTIMADA"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/layoutDistancia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imgDistancia"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="0dp"
                    android:src="@drawable/distancia" />

                <TextView
                    android:id="@+id/txtDistancia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="2.4 km"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutBotones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btnAceptarServicio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/btn_redondo"
            android:gravity="center"
            android:textColor="@color/white"
            android:text="ACEPTAR SERVICIO"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnReportarDificultad"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:gravity="center"
            android:text="REPORTAR DIFICULTAD"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>