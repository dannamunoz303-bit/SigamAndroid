<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&lt;-"
            android:textSize="22sp"
            android:textStyle="bold"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/txtTituloActualizarPerfil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Actualizar Perfil"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="30dp"
            android:layout_height="1dp"/>

    </LinearLayout>

    <View
        android:id="@+id/viewLineaNaranja"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#FF6A2E" />

    <ScrollView
        android:id="@+id/scrollActualizar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/layoutForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EDITAR INFORMACIÓN DE CONTACTO"
                android:textSize="11sp"
                android:textColor="#FF5E1A"
                android:textStyle="bold"/>

            <!-- Nombre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Nombre Completo"
                android:textSize="12sp"
                android:textColor="#555555"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="#F5F5F5"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="Carlos Eduardo Ruiz"
                android:inputType="textPersonName"
                android:textSize="14sp"/>

            <!-- Teléfono -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Teléfono de Contacto"
                android:textSize="12sp"
                android:textColor="#555555"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etTelefono"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="#F5F5F5"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="+57 312 456 7890"
                android:inputType="phone"
                android:textSize="14sp"/>

            <!-- Correo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Correo Electrónico"
                android:textSize="12sp"
                android:textColor="#555555"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="#F5F5F5"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="carlos.ruiz@sigam.gov.co"
                android:inputType="textEmailAddress"
                android:textSize="14sp"/>

            <!-- Dirección -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Dirección de Residencia"
                android:textSize="12sp"
                android:textColor="#555555"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etDireccion"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="#F5F5F5"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="Calle 15 #8-42, Popayán"
                android:inputType="textPostalAddress"
                android:textSize="14sp"/>

            <!-- Contacto Emergencia -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Contacto de Emergencia"
                android:textSize="12sp"
                android:textColor="#555555"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etContactoEmergencia"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="#F5F5F5"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="María Ruiz (+57 311 987 6543)"
                android:inputType="text"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/btn_redondo"
                android:gravity="center"
                android:text="GUARDAR CAMBIOS"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>