<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layoutHeaderTop"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="12dp">

            <TextView
                android:id="@+id/tvBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&lt;-"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/layoutTitulosHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvPaso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PASO 3 DE 4"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/tvDetallesHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detalles del incidente"
                    android:textColor="#000"
                    android:textStyle="bold"
                    android:textSize="18sp"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:id="@+id/viewLineaNaranja"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="#FF5E1A"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvInstruccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Proporciona la información necesaria para el equipo de respuesta."
        android:gravity="center"
        android:padding="16dp"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/layoutCardPersonas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="#F5F5F5"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tvLabelPersonas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Número de personas afectadas"
            android:textColor="#000"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvSubPersonas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aproximación si no es exacto."
            android:textSize="11sp"
            android:layout_marginTop="4dp"/>

        <LinearLayout
            android:id="@+id/layoutContador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/btnMenos"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@drawable/circulonegro"
                android:textStyle="bold"
                android:textSize="30sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/txtNumero"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="#000"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"/>

            <TextView
                android:id="@+id/btnMas"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@drawable/circulonegro2"
                android:textSize="20sp"
                android:gravity="center"/>

        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvLabelObservaciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=" Observaciones adicionales"
        android:textStyle="bold"
        android:textSize="12sp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"/>

    <EditText
        android:id="@+id/etObservaciones"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_margin="12dp"
        android:background="#F5F5F5"
        android:text="Describe lo que está pasando (ej. personas atrapadas, fuego visible, olores fuertes)..."
        android:textColor="#545454"
        android:padding="12dp"
        android:gravity="top"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvLabelContacto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=" Número de contacto"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"/>

    <EditText
        android:id="@+id/etContacto"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginTop="8dp"
        android:background="#F5F5F5"
        android:text=" +57 311 8273 729"
        android:textColor="#545454"
        android:padding="12dp"
        android:inputType="phone"
        android:textSize="13sp"/>


    <TextView
        android:id="@+id/tvAvisoContacto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Solo para uso oficial si requerimos más detalles."
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="6dp"/>

    <View
        android:id="@+id/viewSpacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <Button
        android:id="@+id/btnContinuar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="CONTINUAR"
        android:backgroundTint="#FF5E1A"
        android:layout_margin="16dp"/>

</LinearLayout>