<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/tvIconSuperior"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/superior"
            android:gravity="center"/>

        <TextView
            android:id="@+id/txtSigam"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="  SIGAM"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginLeft="4dp"/>

        <ImageView
            android:id="@+id/imgCampana"
            android:layout_width="40dp"
            android:layout_height="20dp"
            android:src="@drawable/campana" />

    </LinearLayout>
    <View
        android:id="@+id/viewLineaNaranja"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="#FF5E1A"/>

    <LinearLayout
        android:id="@+id/layoutContenido"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtEstadoReporte"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estado de mi Reporte"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtReporteId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reporte #REP-2023-4589"
            android:textSize="12sp"
            android:textColor="#555555"
            android:layout_marginTop="2dp"/>

        <LinearLayout
            android:id="@+id/layoutCardTiempo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="16dp"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/txtLabelTiempo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIEMPO ESTIMADO"
                android:textSize="10sp" />

            <LinearLayout
                android:id="@+id/layoutETA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/txtEtaLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ETA: "
                    android:textSize="28sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtEtaNumero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8"
                    android:textSize="32sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtEtaMin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="min"
                    android:textSize="16sp"
                    android:layout_marginLeft="2dp"
                    android:layout_marginBottom="4dp"/>

            </LinearLayout>
            <LinearLayout
                android:id="@+id/layoutEstadoAmbulancia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imgAsterisco"
                    android:layout_width="40dp"
                    android:layout_height="20dp"
                    android:src="@drawable/asterisco"/>

                <TextView
                    android:id="@+id/txtAmbulanciaCamino"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  Ambulancia en camino"
                    android:textSize="12sp"
                    android:layout_marginLeft="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutSeguimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#f5f5f5f5"
            android:padding="16dp"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/txtLabelSeguimiento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seguimiento"
                android:textSize="13sp"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:id="@+id/layoutSeguimientoRecibido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/layoutIconRecibido"
                    android:layout_width="20dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <View
                        android:id="@+id/viewDotRecibido"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/circulo"/>

                    <View
                        android:id="@+id/viewLineRecibido"
                        android:layout_width="2dp"
                        android:layout_height="30dp"
                        android:background="#FF6A2E"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/layoutTextoRecibido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginLeft="12dp">

                    <TextView
                        android:id="@+id/txtRecibido"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recibido"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtHoraRecibido"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10:42 AM"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSeguimientoValidado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/layoutIconValidado"
                    android:layout_width="20dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <View
                        android:id="@+id/viewDotValidado"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/circulo"/>

                    <View
                        android:id="@+id/viewLineValidado"
                        android:layout_width="2dp"
                        android:layout_height="30dp"
                        android:background="#FF6A2E"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/layoutTextoValidado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginLeft="12dp">

                    <TextView
                        android:id="@+id/txtValidado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Validado"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtHoraValidado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10:44 AM"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSeguimientoAsignado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/layoutIconAsignado"
                    android:layout_width="20dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <View
                        android:id="@+id/viewDotAsignado"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/circulo"/>

                    <View
                        android:id="@+id/viewLineAsignado"
                        android:layout_width="2dp"
                        android:layout_height="30dp"
                        android:background="#FF6A2E"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/layoutTextoAsignado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginLeft="12dp">

                    <TextView
                        android:id="@+id/txtAsignado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asignado"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtUnidadMovil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unidad Móvil 42"
                        android:textSize="11sp"/>

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSeguimientoEnCurso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/layoutIconEnCurso"
                    android:layout_width="20dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <View
                        android:id="@+id/viewDotEnCurso"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@drawable/circulo"/>

                    <View
                        android:id="@+id/viewLineEnCurso"
                        android:layout_width="2dp"
                        android:layout_height="30dp"
                        android:background="#FFCCB0"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/layoutTextoEnCurso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginLeft="12dp">

                    <TextView
                        android:id="@+id/txtEnCurso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En curso"
                        android:textSize="12sp"
                        android:textColor="#FF6A2E"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtEnCursoDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En aproximación a la ubicación"
                        android:textSize="11sp"/>

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSeguimientoFinalizado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/layoutIconFinalizado"
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <View
                        android:id="@+id/viewDotFinalizado"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/circuloo"/>

                </LinearLayout>
                <TextView
                    android:id="@+id/txtFinalizado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Finalizado"
                    android:textSize="12sp"
                    android:textColor="#545454"
                    android:layout_marginLeft="12dp"/>

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutContactarDespacho"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="#f5f5f5f5"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtContactarDespacho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📞 Contactar Despacho"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <View
            android:id="@+id/viewSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnVolverInicio"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="VOLVER AL INICIO"
            android:textColor="#fff"
            android:background="@drawable/btn_redondo"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</LinearLayout>